# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Company Brain
APP_VERSION=0.4.0
DEBUG=false
LOG_LEVEL=INFO

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Supported: openai | gemini | anthropic
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ─── Vector Store ─────────────────────────────────────────────────────────────
# Supported: chroma | qdrant
DEFAULT_VECTOR_STORE=chroma

# ─── Workspace Defaults ───────────────────────────────────────────────────────
DEFAULT_RETENTION_DAYS=365
DEFAULT_MAX_CONTEXT_TOKENS=8000

# ─── Database (Phase 2+) ──────────────────────────────────────────────────────
# Start Postgres with: docker compose up -d
# Run migrations with: .venv/Scripts/python -m alembic upgrade head
DATABASE_URL=postgresql+asyncpg://neuro_user:neuro_password@127.0.0.1:5433/neuro_db
# REDIS_URL=redis://localhost:6379/0      # Phase 6+
# NEO4J_URI=bolt://localhost:7687         # Phase 6+
# NEO4J_USER=neo4j                        # Phase 6+
# NEO4J_PASSWORD=password                 # Phase 6+

# ─── Phase 3: Ingestion Pipeline ─────────────────────────────────────────────
# No additional env vars needed for Phase 3A (synthetic adapter only).
# Phase 3B (GitHub adapter) will add:
GITHUB_TOKEN=ghp_...
# GITHUB_ORG=your-org

# ─── LLM API Keys (Phase 5+) ─────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
