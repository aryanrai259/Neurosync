# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Company Brain
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Supported: openai | gemini | anthropic
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ─── Vector Store ─────────────────────────────────────────────────────────────
# Supported: chroma | qdrant
DEFAULT_VECTOR_STORE=chroma

# ─── Workspace Defaults ───────────────────────────────────────────────────────
DEFAULT_RETENTION_DAYS=365
DEFAULT_MAX_CONTEXT_TOKENS=8000

# ─── Database (added in Phase 2) ──────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/companybrain
# REDIS_URL=redis://localhost:6379/0
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# ─── LLM API Keys (added in Phase 4) ─────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
