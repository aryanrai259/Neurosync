# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Company Brain
APP_VERSION=0.4.0
DEBUG=false
LOG_LEVEL=INFO

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Supported: openai | gemini | anthropic
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ─── Vector Store ─────────────────────────────────────────────────────────────
# Phase 4+: pgvector (uses existing PostgreSQL — no new infra needed)
DEFAULT_VECTOR_STORE=pgvector

# ─── Workspace Defaults ───────────────────────────────────────────────────────
DEFAULT_RETENTION_DAYS=365
DEFAULT_MAX_CONTEXT_TOKENS=8000

# ─── Database (Phase 2+) ──────────────────────────────────────────────────────
# Start Postgres with: docker compose up -d
# Run migrations with: .venv/Scripts/python -m alembic upgrade head
DATABASE_URL=postgresql+asyncpg://neuro_user:neuro_password@127.0.0.1:5433/neuro_db

# ─── Phase 3: Ingestion Pipeline ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ─── Phase 4B: Embeddings (local Ollama) ──────────────────────────────────────
# Install Ollama from https://ollama.ai
# Pull model with: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# ─── Phase 4C: Neo4j Graph ────────────────────────────────────────────────────
# Start Neo4j with: docker compose up -d
# Neo4j browser UI at: http://localhost:7474
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neuro_password

# ─── LLM API Keys (Phase 5+) ─────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
